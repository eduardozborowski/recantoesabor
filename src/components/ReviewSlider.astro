---
import { getCollection } from "astro:content";
const reviews = await getCollection("reviews");
---

<div class="swiper review-slider" aria-label="Depoimentos de clientes">
	<div class="swiper-wrapper">
		{reviews.map((review) => (
			<div class="swiper-slide">
				<article class="review-card">
					<div class="review-stars">Depoimento</div>
					<blockquote>“{review.data.review}”</blockquote>
					<cite>{review.data.author}</cite>
				</article>
			</div>
		))}
	</div>
	<div class="swiper-pagination review-pagination"></div>
</div>

<script>
	import Swiper from "swiper";
	import { A11y, Autoplay, Pagination } from "swiper/modules";
	import "swiper/css";
	import "swiper/css/pagination";

	const element = document.querySelector<HTMLElement>(".review-slider");
	if (element) {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		new Swiper(element, {
			modules: [A11y, Autoplay, Pagination],
			loop: true,
			slidesPerView: 1,
			spaceBetween: 16,
			autoplay: reducedMotion ? false : { delay: 5000, disableOnInteraction: false, pauseOnMouseEnter: true },
			a11y: { enabled: true, paginationBulletMessage: "Ir para o depoimento {{index}}" },
			pagination: { el: ".review-pagination", clickable: true },
			breakpoints: { 800: { slidesPerView: 2, spaceBetween: 24 } },
		});
	}
</script>
