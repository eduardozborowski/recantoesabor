---
import { phone } from "~/data/config";
const whatsappUrl = `https://wa.me/${phone.e164.replace("+", "")}`;
---

<form class="contact-form" id="whatsapp-contact" data-whatsapp-url={whatsappUrl}>
	<div class="field">
		<label for="contact-name">Seu nome</label>
		<input type="text" name="name" id="contact-name" autocomplete="name" required />
	</div>
	<div class="field">
		<label for="contact-subject">Sobre o que deseja falar?</label>
		<input type="text" name="subject" id="contact-subject" placeholder="Ex.: marmita, buffet ou horário" required />
	</div>
	<div class="field">
		<label for="contact-message">Mensagem</label>
		<textarea name="message" id="contact-message" required></textarea>
	</div>
	<button class="button-primary" type="submit">Enviar pelo WhatsApp</button>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>("#whatsapp-contact");
	if (form) {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const text = `Olá! Meu nome é ${data.get("name")}.\n\nAssunto: ${data.get("subject")}\n${data.get("message")}`;
			const whatsappUrl = form.dataset.whatsappUrl;
			if (whatsappUrl) {
				window.open(`${whatsappUrl}?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
			}
		});
	}
</script>
