---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/700.css";
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import {
	address,
	phone,
	siteLang,
	siteName,
	siteUrl,
	socialMedia,
	themeColor,
} from "~/data/config";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Restaurante em Balneário Camboriú | Recanto e Sabor",
	description = "Buffet caseiro livre e por quilo, marmitas e comida brasileira no Centro de Balneário Camboriú. Almoce no Restaurante Recanto e Sabor.",
	image = "/images/logo-site.jpg",
	noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const schema = {
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": `${siteUrl}/#restaurant`,
	name: siteName,
	description,
	url: siteUrl,
	image: socialImage.href,
	telephone: phone.e164,
	priceRange: "R$",
	servesCuisine: ["Comida brasileira", "Comida caseira", "Buffet por quilo", "Marmitas"],
	menu: new URL("/gallery/", siteUrl).href,
	address: {
		"@type": "PostalAddress",
		streetAddress: address.street,
		addressLocality: address.city,
		addressRegion: address.state,
		postalCode: address.zip,
		addressCountry: address.country,
	},
	hasMap: address.mapUrl,
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
		opens: "11:00:00",
		closes: "15:00:00",
	},
	acceptsReservations: false,
	paymentAccepted: "Dinheiro, cartão e PIX",
	sameAs: [socialMedia.instagram, socialMedia.facebook],
};
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="Restaurante Recanto e Sabor em Balneário Camboriú" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="pt_BR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
		<script is:inline>document.documentElement.classList.add("js");</script>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
		<Header />
		<main id="conteudo">
			<slot />
		</main>
		<Footer />
		<div class="contact-floats" aria-label="Canais de atendimento">
			<a
				href={socialMedia.instagram}
				class="contact-float instagram-float"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Chamar o Recanto e Sabor no Instagram"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>
				<span>Chame no Instagram</span>
			</a>
			<a
				href={phone.whatsapp}
				class="contact-float whatsapp-float"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Conversar com o Recanto e Sabor pelo WhatsApp"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.84 9.84 0 0 0-8.47 14.84L2 22l5.3-1.5A9.92 9.92 0 1 0 12.04 2Zm0 17.98a8.12 8.12 0 0 1-4.14-1.13l-.3-.18-3.15.89.91-3.07-.2-.32a8.1 8.1 0 1 1 6.88 3.81Zm4.45-6.07c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.53.06-.24-.12-1.03-.38-1.96-1.21a7.35 7.35 0 0 1-1.36-1.69c-.14-.24-.01-.38.11-.5.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42h-.46c-.16 0-.42.06-.65.3-.22.24-.85.83-.85 2.03s.87 2.36 1 2.52c.12.16 1.72 2.63 4.17 3.69.58.25 1.04.4 1.39.51.58.18 1.12.16 1.54.1.47-.07 1.44-.59 1.64-1.15.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28Z" /></svg>
				<span>Peça no WhatsApp</span>
			</a>
		</div>
		<script>
			const items = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)");
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (!("IntersectionObserver" in window) || reducedMotion) {
				items.forEach((item) => item.classList.add("is-visible"));
			} else {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					});
				}, { threshold: 0.12 });
				items.forEach((item) => observer.observe(item));
			}
		</script>
	</body>
</html>
