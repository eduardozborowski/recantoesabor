---
import Layout from "~/layouts/Layout.astro";
import FormContact from "~/components/forms/FormContact.astro";
import { address, hours, phone, socialMedia } from "~/data/config";
---

<Layout title="Contato e localização | Recanto e Sabor" description="Fale com o Restaurante Recanto e Sabor pelo WhatsApp, veja o horário e encontre nosso buffet no Centro de Balneário Camboriú.">
	<header class="page-hero">
		<div class="site-container" data-reveal>
			<p class="eyebrow">Estamos por perto</p>
			<h1>Fale com a gente ou venha nos visitar.</h1>
			<p>Pedidos de marmita, dúvidas e informações sobre o buffet: envie uma mensagem pelo WhatsApp.</p>
		</div>
	</header>

	<section class="content-section">
		<div class="site-container contact-grid">
			<aside class="contact-details" data-reveal>
				<h2>Informações</h2>
				<div class="contact-block"><span>Endereço</span><a href={address.mapUrl} target="_blank" rel="noopener noreferrer">{address.street}, {address.district}<br />{address.city} – {address.state}</a></div>
				<div class="contact-block"><span>Horário</span><strong>{hours.short}</strong></div>
				<div class="contact-block"><span>Telefone e WhatsApp</span><a href={phone.whatsapp} target="_blank" rel="noopener noreferrer">{phone.label}</a></div>
				<div class="contact-block"><span>Redes sociais</span><a href={socialMedia.instagram} target="_blank" rel="noopener noreferrer">@recantoesaborbc</a></div>
			</aside>
			<div data-reveal>
				<p class="eyebrow">Mensagem rápida</p>
				<h2 class="section-title">Como podemos ajudar?</h2>
				<p class="section-copy">Preencha os campos e a conversa será aberta diretamente no WhatsApp do restaurante.</p>
				<FormContact />
			</div>
		</div>
	</section>
</Layout>
