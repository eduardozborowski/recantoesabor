---
import { Picture } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import FoodCarousel from "~/components/FoodCarousel.astro";
import ReviewSlider from "~/components/ReviewSlider.astro";
import Buffet from "~/assets/images/comida3.jpg";
import Fachada from "~/assets/images/logo-site.jpg";
import { address, hours, phone } from "~/data/config";
---

<Layout
	title="Restaurante em Balneário Camboriú | Recanto e Sabor"
	description="Buffet caseiro livre e por quilo, marmitas e comida brasileira no Centro de Balneário Camboriú. Almoce de segunda a sábado no Recanto e Sabor."
>
	<section class="home-hero">
		<div class="site-container hero-grid">
			<div data-reveal>
				<p class="eyebrow">Restaurante popular no Centro de BC</p>
				<h1 class="hero-title">Comida de verdade, com <em>sabor de casa.</em></h1>
				<p class="hero-copy">Buffet livre, por quilo e marmitas com variedade todos os dias. Um almoço bem servido, acolhedor e com preço justo em Balneário Camboriú.</p>
				<div class="hero-actions">
					<a class="button-primary" href={address.mapUrl} target="_blank" rel="noopener noreferrer">Ver como chegar</a>
					<a class="button-secondary" href={phone.whatsapp} target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
				</div>
				<p class="hero-note">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
					{hours.short}
				</p>
			</div>

			<div class="hero-visual" data-reveal>
				<Picture class="hero-main-image" src={Buffet} alt="Buffet e salão do Restaurante Recanto e Sabor em Balneário Camboriú" widths={[640, 900, 1200]} sizes="(max-width: 900px) 100vw, 52vw" formats={["avif", "webp"]} priority />
				<Picture class="hero-small-image" src={Fachada} alt="Fachada vermelha do Restaurante Recanto e Sabor" widths={[480, 800, 1200]} sizes="(max-width: 600px) 55vw, 300px" formats={["avif", "webp"]} quality="high" />
				<div class="hero-stamp">Almoço<br />de segunda<br />a sábado</div>
			</div>
		</div>
	</section>

	<div class="service-strip" data-reveal>
		<div class="site-container service-grid">
			<div class="service-item"><span>Escolha como prefere</span><strong>Buffet livre</strong></div>
			<div class="service-item"><span>Monte o seu prato</span><strong>Comida por quilo</strong></div>
			<div class="service-item"><span>Praticidade no dia</span><strong>Marmitas para levar</strong></div>
			<div class="service-item"><span>De segunda a sábado</span><strong>Das 11h às 15h</strong></div>
		</div>
	</div>

	<section class="intro-section">
		<div class="site-container intro-grid">
			<div class="intro-aside" data-reveal>
				<p class="eyebrow">O Recanto</p>
				<h2 class="section-title">Seu almoço do dia, sem complicação.</h2>
				<p>Para a pausa do trabalho, o almoço em família ou uma refeição gostosa durante a viagem.</p>
			</div>

			<div class="values-grid">
				<article class="value-card" data-reveal>
					<span class="value-number">01</span>
					<div><h3>Variedade que muda</h3><p>Carnes, massas, saladas, legumes e acompanhamentos preparados para deixar cada prato completo.</p></div>
				</article>
				<article class="value-card" data-reveal>
					<span class="value-number">02</span>
					<div><h3>Tempero brasileiro</h3><p>Receitas conhecidas, ingredientes frescos e aquele cuidado que transforma a refeição em comida de casa.</p></div>
				</article>
				<article class="value-card" data-reveal>
					<span class="value-number">03</span>
					<div><h3>No ritmo da sua rotina</h3><p>Sirva-se à vontade, escolha por quilo ou leve uma marmita. Você decide como aproveitar o almoço.</p></div>
				</article>
			</div>
		</div>
	</section>

	<section class="food-section">
		<div class="site-container">
			<div class="section-heading" data-reveal>
				<div>
					<p class="eyebrow">Direto do nosso buffet</p>
					<h2 class="section-title">Um pouco do que espera por você.</h2>
				</div>
				<div class="slider-controls" aria-label="Controles do carrossel">
					<button class="slider-button food-prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></button>
					<button class="slider-button food-next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg></button>
				</div>
			</div>
			<FoodCarousel />
			<div class="hero-actions" data-reveal>
				<a class="button-primary" href="/gallery">Ver fotos do restaurante</a>
			</div>
		</div>
	</section>

	<section class="experience-section">
		<div class="site-container">
			<p class="eyebrow" data-reveal>Do seu jeito</p>
			<h2 class="section-title" data-reveal>Três formas de aproveitar o Recanto.</h2>
			<div class="experience-grid">
				<article class="experience-card" data-reveal><span>01</span><h3>Buffet livre</h3><p>Repita os pratos que mais gostar e aproveite a variedade do dia.</p></article>
				<article class="experience-card" data-reveal><span>02</span><h3>Por quilo</h3><p>Monte sua combinação na medida da sua fome, com liberdade de escolha.</p></article>
				<article class="experience-card" data-reveal><span>03</span><h3>Para levar</h3><p>Peça sua marmita e tenha um almoço caseiro onde você estiver.</p></article>
			</div>
		</div>
	</section>

	<section class="review-section">
		<div class="site-container">
			<div class="section-heading" data-reveal>
				<div>
					<p class="eyebrow">Opinião de quem conhece</p>
					<h2 class="section-title">Quem almoça, recomenda.</h2>
				</div>
				<p class="section-copy">Atendimento acolhedor, comida saborosa e aquele lugar para voltar sempre.</p>
			</div>
			<ReviewSlider />
		</div>
	</section>

	<section class="location-section" id="localizacao">
		<div class="site-container location-card" data-reveal>
			<div class="location-info">
				<p class="eyebrow">Fácil de encontrar</p>
				<h2>Seu almoço no Centro de Balneário Camboriú.</h2>
				<address>{address.street}, {address.district}<br />{address.city} – {address.state}<br />CEP {address.zip}</address>
				<p>{hours.short}</p>
				<a class="button-secondary" href={address.mapUrl} target="_blank" rel="noopener noreferrer">Abrir rota no Google Maps</a>
			</div>
			<div class="location-map">
				<iframe title="Mapa do Restaurante Recanto e Sabor" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14219.290219692311!2d-48.638795344580096!3d-27.0041624!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94d8b7dfefaa9311%3A0x3294e807011a3a25!2sRestaurante%20Recanto%20e%20Sabor!5e0!3m2!1spt-BR!2sbr!4v1753577448846!5m2!1spt-BR!2sbr" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>
		</div>
	</section>
</Layout>
